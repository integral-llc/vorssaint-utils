/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Vorssaint usa Automazione per spostare file, inviare elementi al Cestino, aprire i comandi richiesti e controllare la riproduzione nelle tue app multimediali.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Vorssaint usa l'audio di ogni app per regolarne il volume nel mixer, per muovere le barre musicali di Dynamic Island e per includere l'audio del Mac nelle registrazioni dello schermo che avvii. Nulla lascia il tuo Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Vorssaint usa il Bluetooth solo per leggere la batteria delle periferiche connesse. Nulla lascia il tuo Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Vorssaint registra il microfono solo quando lo attivi per una registrazione dello schermo. L’audio resta sul tuo Mac, a meno che tu scelga di creare un link temporaneo.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Vorssaint mostra la fotocamera solo nella finestra di anteprima che apri, così puoi controllare il tuo aspetto prima di una chiamata. Nulla viene registrato e nulla lascia il tuo Mac.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "Vorssaint salva qui le trascrizioni che avvii e controlla i metadati locali per esaminare, organizzare o spostare nel Cestino solo i file WhatsApp confermati scelti da te.";
